---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getI18n } from '../i18n/context';
import { getArticles } from '../lib/articles';

const artikelBlog = getArticles('id');
const { path } = getI18n(Astro.currentLocale);
---

<Layout title="Blog & Catatan" description="Tulisan dan catatan seputar statistika dan analisis data">
  <Section>
    <SectionHeader
      eyebrow="Tulisan & Catatan"
      title="Blog Statistika"
      description="Kumpulan catatan kuliah, ringkasan konsep statistika, dan pengalaman belajar analisis data."
    />

    <div class="grid max-w-4xl gap-5 md:grid-cols-2">
      {artikelBlog.map((item) => (
        <article class="flex flex-col rounded border border-hairline p-6">
          <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
            <span class="rounded border border-hairline px-2 py-1">{item.category}</span>
            <time datetime={item.isoDate}>{item.date}</time>
          </div>
          <h2 class="mt-4 text-xl font-bold">{item.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.summary}</p>
          <a href={path(`/blog/${item.slug}`)} class="mt-auto pt-5 font-mono text-xs text-accent hover:underline">
            Baca artikel
          </a>
        </article>
      ))}
    </div>
  </Section>
</Layout>