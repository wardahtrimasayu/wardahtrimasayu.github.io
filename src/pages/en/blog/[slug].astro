---
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/Section.astro';
import { getI18n } from '../../../i18n/context';
import { getArticles, type Article } from '../../../lib/articles';
import { renderMarkdown } from '../../../lib/markdown';

export function getStaticPaths() {
  return getArticles('en').map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { path } = getI18n(Astro.currentLocale);
const html = await renderMarkdown(article.body);
---

<Layout title={article.title} description={article.summary}>
  <Section last>
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 font-mono text-xs text-muted">
      <a href={path('/blog')} class="hover:text-fg">
        Blog
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page" class="text-fg">
        {article.title}
      </span>
    </nav>
    <header class="max-w-2xl border-b border-hairline pb-8">
      <p class="eyebrow">{article.category}</p>
      <h1 class="mt-3 font-serif text-3xl text-fg sm:text-4xl">{article.title}</h1>
      <time class="mt-4 block font-mono text-xs text-muted" datetime={article.isoDate}>
        {article.date}
      </time>
      <p class="mt-5 text-sm leading-relaxed text-muted">{article.summary}</p>
    </header>
    <article class="prose mt-10 max-w-2xl" set:html={html} />
  </Section>
</Layout>
