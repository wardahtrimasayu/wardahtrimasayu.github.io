---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<Layout title="Contact" description="Contact Wardah Tri Masayu">
  <Section>
    <SectionHeader
      eyebrow="Contact"
      title="Get in Touch"
      description="You can contact me by email, social media, or the message form below."
    />
    <div class="max-w-2xl space-y-6">
      <div class="space-y-2 text-muted">
        <p>
          <strong>Email:</strong>{' '}
          <a href="mailto:wardahmasayu05@gmail.com" class="underline">
            wardahmasayu05@gmail.com
          </a>
        </p>
        <p>
          <strong>GitHub:</strong>{' '}
          <a href="https://wardahtrimasayu.github.com" target="_blank" class="underline">
            https://wardahtrimasayu.github.com
          </a>
        </p>
      </div>
      <form action="https://formspree.io" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm mb-1" for="name">
            Name
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full p-2 rounded border bg-transparent"
            placeholder="Your name"
          />
        </div>
        <div>
          <label class="block text-sm mb-1" for="email">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full p-2 rounded border bg-transparent"
            placeholder="email@example.com"
          />
        </div>
        <div>
          <label class="block text-sm mb-1" for="message">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full p-2 rounded border bg-transparent"
            placeholder="Write your message..."
          ></textarea>
        </div>
        <button type="submit" class="px-4 py-2 rounded border font-medium">
          Send Message
        </button>
      </form>
    </div>
  </Section>
</Layout>
