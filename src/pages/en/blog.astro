---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getI18n } from '../../i18n/context';
import { getArticles } from '../../lib/articles';

const articles = getArticles('en');
const { path } = getI18n(Astro.currentLocale);
---

<Layout title="Blog & Notes" description="Notes and writing about statistics and data analysis">
  <Section>
    <SectionHeader
      eyebrow="Writing & Notes"
      title="Statistics Blog"
      description="A collection of class notes, statistics concepts, and data-analysis learning experiences."
    />
    <div class="grid max-w-4xl gap-5 md:grid-cols-2">
      {articles.map(article => (
        <article class="flex flex-col rounded border border-hairline p-6">
          <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
            <span class="rounded border border-hairline px-2 py-1">{article.category}</span>
            <time datetime={article.isoDate}>{article.date}</time>
          </div>
          <h2 class="mt-4 text-xl font-bold">{article.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{article.summary}</p>
          <a href={path(`/blog/${article.slug}`)} class="mt-auto pt-5 font-mono text-xs text-accent hover:underline">
            Read article
          </a>
        </article>
      ))}
    </div>
  </Section>
</Layout>
